NODE_ENV=development
PORT=5000
# Leave blank to use the persistent embedded MongoDB in local development.
# For MongoDB Atlas or a local service, set the full connection string here.
MONGO_URI=
MONGO_MEMORY_FALLBACK=true
MONGO_DATA_PATH=.data/mongodb
SEED_DEMO_DATA=true
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
CLIENT_ORIGIN=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@university.example
