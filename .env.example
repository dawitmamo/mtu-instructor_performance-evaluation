NODE_ENV=development
PORT=5000
TRUST_PROXY=false
# Leave blank to use the persistent embedded MongoDB in local development.
# For MongoDB Atlas or a local service, set the full connection string here.
MONGO_URI=
MONGO_MEMORY_FALLBACK=true
MONGO_DATA_PATH=.data/mongodb
SEED_DEMO_DATA=true
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
CLIENT_ORIGIN=http://localhost:5173

# Google OAuth 2.0 credentials from Google Cloud Console.
# Keep the client secret on the backend only; never expose it with a VITE_ prefix.
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
GOOGLE_OAUTH_ALLOWED_DOMAIN=mtu.edu.et
# Public browser client ID for a future Google Sign-In button.
VITE_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com

# SMTP email delivery for evaluations, results, course allocations, stream
# selection, schedules, and HOD announcements. Use credentials supplied by MTU.
EMAIL_NOTIFICATIONS_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@mtu.edu.et
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM="MTU UAMIPES <no-reply@mtu.edu.et>"
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_INTERVAL_MS=60000
